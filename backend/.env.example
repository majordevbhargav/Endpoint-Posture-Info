# --- PostgreSQL --------------------------------------------------------
# Either set the discrete POSTGRES_* vars, or set DATABASE_URL to override
# them entirely (e.g. for a managed/cloud Postgres instance).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=posture
POSTGRES_USER=posture
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://posture:change-me@localhost:5432/posture
POSTGRES_MAX_CONN=10

# --- Cisco ISE (Section 15, question 3 - fill in once confirmed) -------
ISE_HOST=https://10.6.1.90
ISE_USER=Dev
ISE_PASS=Login@123
ISE_VERIFY_TLS=false
ENFORCEMENT_MODE=attribute
# ers (default, ships first) or pxgrid (Phase 5, requires pxGrid persona +
# client certs, see project plan Section 10 / Section 15 question 3)
ENFORCEMENT_TRANSPORT=ers

# --- posture_app.py ------------------------------------------------------
POSTURE_API_KEY=
POSTURE_LISTEN_HOST=127.0.0.1
POSTURE_LISTEN_PORT=8000

# --- posture_ui.py ---------------------------------------------------
UI_PORT=5000
POSTURE_SERVER=http://127.0.0.1:8000/api/v1/posture
POSTURE_APP_BASE=http://127.0.0.1:8000
# FRONTEND_DIR defaults to ../../frontend/public relative to posture_ui.py;
# only set this if you move the frontend folder elsewhere.
# FRONTEND_DIR=/path/to/frontend/public
AUTO_WORKER_POLL_SECONDS=3

# --- queue / watcher coordination (flat files, replaced by Redis in Phase 6) --
PENDING_QUEUE_FILE=pending_devices.txt
SEEN_MACS_FILE=seen_macs.txt
IP_MAC_MAP_FILE=ip_mac_map.txt

# --- ise_session_watcher.py --------------------------------------------
WATCHER_POLL_SECONDS=20
RECHECK_INTERVAL_SECONDS=14400
